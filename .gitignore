# Whitelist: ignore everything, then allow what defines the modpack
/*
!.gitignore
!mmc-pack.json

!minecraft/
/minecraft/*
!minecraft/icon.png
!minecraft/mods/
!minecraft/config/
!minecraft/defaultconfigs/
!minecraft/kubejs/
!minecraft/resourcepacks/
!minecraft/shaderpacks/

# Per-user client settings inside config/
minecraft/config/*-client.toml
minecraft/config/sodium-options.json
minecraft/config/sodium-fingerprint.json
minecraft/config/iris.properties
minecraft/config/iris-excluded.json
